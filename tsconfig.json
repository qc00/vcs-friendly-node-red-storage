{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "target": "es2020",
        "module": "commonjs",
        "removeComments": true,
        "noImplicitReturns": true,
        "noUncheckedIndexedAccess": true,
        "types": ["node"]
    },
    "include": [
        "src/**/*"
    ]
}
