{
  "name": "@qc00/vcs-friendly-node-red-storage",
  "version": "0.2.0",
  "description": "A Node-RED storage plug-in that stores the flow in formats more suitable for a version control system (VCS) e.g. git.",
  "main": "build/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qc00/vcs-friendly-node-red-storage.git"
  },
  "keywords": [
    "storage"
  ],
  "author": "qc00",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qc00/vcs-friendly-node-red-storage/issues"
  },
  "homepage": "https://github.com/qc00/vcs-friendly-node-red-storage#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/test/**/*.test.js\"",
    "clean": "rm -rf build build-test",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/node-red": "^1.3.5",
    "typescript": "^5.5.4"
  },
  "node-red": {
    "version": ">=4.1.0",
    "nodes": {
      "vcs-friendly-node-red-storage": "build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public"
  }
}
